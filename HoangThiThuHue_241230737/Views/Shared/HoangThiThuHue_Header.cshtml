@inject HoangThiThuHue_241230737.Models.QLTaiSanContext db

<header class="header">
    <div class="topbar">
        <div class="container">
            <span>Phòng Hành chính - Quản trị: <b>(024) 3999 8888</b> &nbsp;|&nbsp; Hỗ trợ: taisan@assethub.vn</span>
            <span>Xin chào, Quản trị viên &nbsp;|&nbsp; Đăng xuất</span>
        </div>
    </div>
    <div class="header-main">
        <div class="container">
            <a href="index.html"><img src="~/images/logo.png" alt="AssetHub" /></a>
            <div class="cart-box">Tổng tài sản: 16 - Nguyên giá: 3.125 triệu</div>
        </div>
    </div>
    <nav class="navbar">
        <div class="container">
            <ul class="menu">
                <li class="active"><a href="@Url.Action("Index","Home")">Hoang Thi Thu Hue</a></li>
                @foreach (var l in db.LoaiTaiSans)
                {
                    <li>
                        <a href="#" class="loai-link"
                        data-url="@Url.Action("GetTaiSanByLoai","Home", new {id=l.MaLoai})">@l.TenLoai</a>
                    </li>
                }
            </ul>
            <a href="@Url.Action("Create", "Home")" style="color:blue;font-weight: 600; margin-left: 16px; white-space:nowrap">Thêm tài sản</a>
            <form class="search-box">
                <input type="text" placeholder="Tìm tài sản..." />
                <button type="button">Tìm</button>
            </form>
        </div>
    </nav>
</header>